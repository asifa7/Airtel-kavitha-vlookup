function bind(){const $=id=>document.getElementById(id);const addDrop=(id,kind)=>{const el=$(id);if(!el)return;el.addEventListener('dragover',e=>{e.preventDefault();el.style.borderColor='#ef4444';el.style.background='#fff7f7'});el.addEventListener('dragleave',()=>{el.style.borderColor='';el.style.background=''});el.addEventListener('drop',async e=>{e.preventDefault();el.style.borderColor='';el.style.background='';const f=e.dataTransfer?.files?.[0];if(!f)return;try{const p=await parseFile(f,kind);kind==='master'?setMaster(p,f.name):setLookup(p,f.name)}catch(err){setFileStatus('Could not read '+f.name+': '+(err?.message||String(err)));render()}})};addDrop('masterdrop','master');addDrop('lookupdrop','lookup');$('reset')?.addEventListener('click',reset);$('masterbrowse')?.addEventListener('click',()=>fileInput('master'));$('lookupbrowse')?.addEventListener('click',()=>fileInput('lookup'));$('masterdrop')?.addEventListener('click',e=>{if(e.target.closest('select')||e.target.closest('.file-row'))return;fileInput('master')});$('lookupdrop')?.addEventListener('click',e=>{if(e.target.closest('select')||e.target.closest('.file-row'))return;fileInput('lookup')});$('voicecol')?.addEventListener('change',e=>{state.masterVoiceCol=e.target.value;state.items=[];render()});$('dslcol')?.addEventListener('change',e=>{state.masterDslCol=e.target.value;state.items=[];render()});$('lookupcol')?.addEventListener('change',e=>{state.lookupKeyCol=e.target.value;state.items=[];render()});$('run')?.addEventListener('click',runMatch);$('csv')?.addEventListener('click',exportCsv);document.querySelectorAll('[data-tab]').forEach(b=>b.addEventListener('click',()=>{state.tab=b.dataset.tab;state.page=1;render()}));$('search')?.addEventListener('input',e=>{state.query=e.target.value;state.page=1;render();const el=$('search');if(el){el.focus();el.setSelectionRange(el.value.length,el.value.length)}});$('pagesize')?.addEventListener('change',e=>{state.pageSize=Number(e.target.value);state.page=1;render()});$('prev')?.addEventListener('click',()=>{if(state.page>1){state.page--;render()}});$('next')?.addEventListener('click',()=>{state.page++;render()});document.querySelectorAll('[data-copy]').forEach(b=>b.addEventListener('click',()=>copyText(b.dataset.copy)));document.querySelectorAll('[data-inspect]').forEach(b=>b.addEventListener('click',()=>{const it=state.items.find(x=>x.index===Number(b.dataset.inspect));state.inspect=it;render()}));$('closemodal')?.addEventListener('click',()=>{state.inspect=null;render()});$('closemodal2')?.addEventListener('click',()=>{state.inspect=null;render()});}

document.addEventListener('DOMContentLoaded',()=>{render()});
})();
</script></body></html>
